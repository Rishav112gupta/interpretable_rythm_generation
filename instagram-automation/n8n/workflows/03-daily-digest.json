{
  "name": "Instagram Automation - daily digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "c3c3d3e3-0000-4000-8000-000000000001",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "c3c3d3e3-0000-4000-8000-000000000005",
      "name": "Run now (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.IA_API_URL }}/dashboard",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "c3c3d3e3-0000-4000-8000-000000000002",
      "name": "Get dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "iaApiKeyCredential01",
          "name": "Instagram Automation API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Builds a daily summary from GET /api/dashboard.\nconst d = $input.first().json;\nconst c = d.counts;\nconst lines = [\n  `📊 Instagram daily digest (${d.timezone})`,\n  `Pending approval: ${c.pending_approval} · Scheduled: ${c.scheduled} · Published: ${c.published} · Failed: ${c.failed}`,\n  d.next_scheduled ? `Next post: \"${d.next_scheduled.headline || d.next_scheduled.topic}\" at ${d.next_scheduled.scheduled_at}` : 'Nothing scheduled.',\n  d.instagram.connected ? `Instagram: @${d.instagram.username}${d.instagram.is_mock ? ' (MOCK)' : ''}` : '⚠ Instagram is NOT connected',\n  d.publishing_enabled ? '' : '⛔ Publishing is paused',\n  ...(d.recent_errors || []).slice(0, 3).map(e => `⚠ ${e.source}: ${e.message}`),\n].filter(Boolean);\nreturn [{ json: { message: lines.join('\\n') } }];"
      },
      "id": "c3c3d3e3-0000-4000-8000-000000000003",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {},
      "id": "c3c3d3e3-0000-4000-8000-000000000004",
      "name": "Send digest (replace with Slack / Email / Telegram)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    }
  ],
  "connections": {
    "Every day at 09:00": {
