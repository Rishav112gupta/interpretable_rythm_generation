# =============================================================================
# Instagram Automation - environment configuration
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# With the defaults below the whole app runs locally WITHOUT any real API keys
# (all external services are mocked).
# =============================================================================

# ---- General ----------------------------------------------------------------
APP_ENV=development                 # development | production
# Random string, at least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Encrypts Instagram tokens stored in the database. REQUIRED in production. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Public URL where the backend/media are reachable. Instagram downloads post images
# from here, so in production this MUST be a public https URL (e.g. https://social.yourcompany.com).
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First dashboard admin (created on first start only)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-this-password

# ---- Database / queue ---------------------------------------------------------
# docker compose builds DATABASE_URL/REDIS_URL itself from these:
POSTGRES_USER=insta
POSTGRES_PASSWORD=insta
POSTGRES_DB=insta
# When running the backend WITHOUT docker, set these instead:
DATABASE_URL=postgresql+psycopg://insta:insta@localhost:5432/insta
REDIS_URL=redis://localhost:6379/0

# ---- Mock switches (true = no real API calls, nothing is published) ----------
MOCK_LLM=true
MOCK_IMAGE_GENERATION=true
MOCK_INSTAGRAM=true
MOCK_GOOGLE_SHEETS=true

# ---- LLM (text generation) ----------------------------------------------------
# anthropic -> https://console.anthropic.com  (API Keys)
# openai    -> https://platform.openai.com/api-keys  (or any OpenAI-compatible API via LLM_BASE_URL)
LLM_PROVIDER=anthropic              # anthropic | openai | mock
LLM_API_KEY=
LLM_MODEL=                          # empty = claude-opus-5-5 for anthropic; REQUIRED for openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120

# ---- Image generation -----------------------------------------------------------
IMAGE_PROVIDER=openai               # openai | none | mock
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_BASE_URL=https://api.openai.com/v1

# ---- Storage for images ------------------------------------------------------------
STORAGE_BACKEND=local               # local | s3
MEDIA_ROOT=./media
# S3-compatible storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO). Objects must be publicly readable.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Meta / Instagram ------------------------------------------------------------------
# instagram = Instagram API with Instagram Login (recommended; graph.instagram.com)
# facebook  = Instagram API with Facebook Login (graph.facebook.com; use META_ACCESS_TOKEN)
META_LOGIN_TYPE=instagram
META_GRAPH_API_VERSION=v25.0
# From Meta App Dashboard -> your app -> Instagram -> API setup with Instagram login -> "Instagram app ID/secret"
META_APP_ID=
META_APP_SECRET=
# Must be registered as an OAuth redirect URI in the Meta App Dashboard (Business login settings)
META_REDIRECT_URI=http://localhost:8080/api/instagram/oauth/callback
META_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish
# Optional alternative to the OAuth "Connect" button: paste a token + account id
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ---- Publishing ----------------------------------------------------------------------------
PUBLISHING_ENABLED=true
PUBLISH_RETRY_DELAYS=60,300,900      # seconds between retries (1, 5, 15 minutes)

# ---- Google Sheets (optional) ------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
# Service account key: path inside the container/host, OR the JSON itself in one line
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=                     # the long id in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_WORKSHEET=Posts

# ---- Rate limits (per user / IP, per minute) ------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
GENERATION_RATE_LIMIT_PER_MINUTE=20
